APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
EMBEDDING_PROVIDER=local
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
VECTOR_STORE=chroma
DATABASE_URL=sqlite:///./incidentgraph.db
MAX_UPLOAD_BYTES=10485760
MAX_REPOSITORY_FILES=3000
MAX_FILE_BYTES=500000
MAX_TOTAL_EXTRACTED_BYTES=100000000
CHUNK_TOKEN_LIMIT=900
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.05
MAX_CONTEXT_TOKENS=12000

# --- IncidentGraph operational extensions (documented in README) ---
# Root directory for uploads, temp workspaces, and the Chroma persistence dir.
DATA_DIR=./data
# Remote fallback for embeddings when the local model cannot be hosted
# (EMBEDDING_PROVIDER=remote). Must expose an OpenAI-compatible /embeddings route.
EMBEDDING_REMOTE_BASE_URL=
EMBEDDING_REMOTE_API_KEY=
EMBEDDING_REMOTE_MODEL=
# Batch + retry tuning for the embedding adapter.
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=4
# Network timeouts (seconds).
GITHUB_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=60
# Vector store persistence location (relative to DATA_DIR when relative).
CHROMA_PERSIST_DIR=./data/chroma
